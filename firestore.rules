rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) 
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 150;
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'createdAt']));

      // Private user subcollection
      match /private/info {
        allow read, write: if isOwner(userId);
      }
    }

    // --- LIFE POSTS COLLECTION ---
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && isValidId(postId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;
      allow update: if isSignedIn()
        && (
          // Like or bookmark counter increment
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'bookmarksCount', 'comments'])
          // Or post author update
          || (resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId)
        );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // --- STUDY INSIGHTS COLLECTION ---
    match /insights/{insightId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(insightId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;
      allow update: if isSignedIn()
        && (
          // Like / comments update
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'comments'])
          // Or author update
          || (resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId)
        );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // --- STORE PRODUCTS CATALOG ---
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(productId)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200;
      allow update: if isSignedIn()
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plantedCount', 'likesCount', 'comments', 'inStock'])
          || request.auth.uid != null
        );
    }

    // --- STORIES WALL COLLECTION ---
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(storyId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;
      allow update: if isSignedIn()
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'comments'])
          || (resource.data.authorId == request.auth.uid)
        );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // --- ORDERS COLLECTION ---
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() 
        && isValidId(orderId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
