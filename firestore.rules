rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create: if isValidId(userId)
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;
      allow update: if isValidId(userId)
        && request.resource.data.uid == userId;

      // Private user subcollection
      match /private/info {
        allow read, write: if isValidId(userId);
      }
    }

    // --- LIFE POSTS COLLECTION ---
    match /posts/{postId} {
      allow read: if true;
      allow create: if isValidId(postId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;
      allow update: if isValidId(postId);
      allow delete: if isValidId(postId);
    }

    // --- STUDY INSIGHTS COLLECTION ---
    match /insights/{insightId} {
      allow read: if true;
      allow create: if isValidId(insightId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;
      allow update: if isValidId(insightId);
      allow delete: if isValidId(insightId);
    }

    // --- STORE PRODUCTS CATALOG ---
    match /products/{productId} {
      allow read: if true;
      allow create: if isValidId(productId)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200;
      allow update: if isValidId(productId);
    }

    // --- STORIES WALL COLLECTION ---
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isValidId(storyId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;
      allow update: if isValidId(storyId);
      allow delete: if isValidId(storyId);
    }

    // --- ORDERS COLLECTION ---
    match /orders/{orderId} {
      allow read: if isValidId(orderId);
      allow create: if isValidId(orderId);
      allow update: if isValidId(orderId);
    }

    // --- INVESTMENTS STORIES & Q&A COLLECTION ---
    match /investments/{investmentId} {
      allow read: if true;
      allow create: if isValidId(investmentId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;
      allow update: if isValidId(investmentId);
      allow delete: if isValidId(investmentId);
    }

    // --- MODERATION EMAILS COLLECTION ---
    match /moderation_emails/{emailId} {
      allow read: if true;
      allow create: if isValidId(emailId);
      allow update: if isValidId(emailId);
      allow delete: if isValidId(emailId);
    }
  }
}
